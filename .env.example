# =============================================================================
# Variáveis compartilhadas  lidas pelo Docker Compose (env_file) e pela API.
# Copie para .env e preencha os segredos.
# =============================================================================

# Postgres (serviço db + URL da API no Compose)
POSTGRES_DB=job_match
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PUBLISHED_PORT=5433

# Redis
REDIS_PUBLISHED_PORT=6380

# API
API_PUBLISHED_PORT=8002
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/job_match

# Render + Supabase: Session pooler (não db.*.supabase.co — IPv6, Render não alcança)
# DB_HOST=aws-0-REGIAO.pooler.supabase.com
# DB_USER=postgres.SEU_PROJECT_REF
# DB_PASSWORD=sua-senha-do-supabase
# DB_PORT=5432
# DB_NAME=postgres
# DB_SSL=true
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI (extração de skills da vaga + parse do currículo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# E-mail alertas (Fase 5)
RESEND_API_KEY=

# Web (apps/web)  prefixo VITE_ expõe ao bundle
VITE_API_URL=http://localhost:8002
